{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "inputs": [
                "src/**/*",
                "*.json",
                "*.js",
                "*.ts"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "check": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "@packages/collection#build": {
            "outputs": [
                "build"
            ]
        },
        "@packages/movno#build": {
            "outputs": [
                "build"
            ]
        },
        "@packages/path#build": {
            "outputs": [
                "build"
            ]
        },
        "kompas": {
            "outputs": [
                "dist"
            ]
        },
        "portal": {
            "outputs": [
                "other"
            ]
        },
        "qwik": {
            "outputs": [
                "server",
                "dist"
            ]
        }
    }
}