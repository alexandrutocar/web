---
import Template from "~/components/TemplateWellcome.astro";

import Logo from "~/components/Logo.astro";
import Type from "~/components/Type.astro";
import Line from "~/components/Line.astro";
---

<Template title="at my quiet place">
    <Logo slot="logo">
        <Type>
            <Line>at.my</Line>
            <Line>quiet</Line>
            <Line>place</Line>
        </Type>
    </Logo>
    <Fragment slot="title">at my quiet place </Fragment>
    <Fragment slot="about">
        <p>my name's alexandru tocar.</p>
        <p>
            i study cyber security, radio astronomy and psychology at the
            university of bonn.
        </p>
        <p>
            my passion lies in declarative approaches to all things software. i
            like making things simple and available to others (the greatest
            guidence here would be the kiss principle).
        </p>
        <p>
            in my spare time i write music, tinker with nixos, systemd, and old
            analog hardware. when the sun's out - i cycle, jog and pull the bar,
            and when it's cloudy, i'd rather read webtoon or watch a moview
            (with some tee along).
        </p>
    </Fragment>
</Template>

<script>
    import { animate } from "~/components/Logo.anim";

    animate.line(0, "at.my", 10);
    animate.line(1, "quiet", 10);
    animate.line(2, "place", 10);
</script>
