---
import Template from "~/components/TemplateNotFound.astro";

import Logo from "~/components/Logo.astro";
import Type from "~/components/Type.astro";
import Line from "~/components/Line.astro";
---

<Template title="404">
    <Logo slot="logo">
        <Type>
            <Line>{"---->"}</Line>
            <Line>{"-404-"}</Line>
            <Line>{"<----"}</Line>
        </Type>
    </Logo>
    <Fragment slot="message">404</Fragment>
</Template>

<script>
    import { animate } from "~/components/Logo.anim";

    animate.line(0, "-----", 10);
    animate.line(1, "-404-", 10);
    animate.line(2, "-----", 10);
</script>
