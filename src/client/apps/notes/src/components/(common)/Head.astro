---
import { getLocale } from "~/modules/i18n/locale";
import { useTranslations } from "~/modules/i18n/translations";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const { url } = Astro;
---

<link
    rel="alternate"
    type="application/atom+xml"
    href={new URL(`/${locale}/${t("notes")}/atom.xml`, url)}
    title={`${t("title")} (Atom Feed)`}
/>
<link
    rel="alternate"
    type="application/feed+json"
    href={new URL(`/${locale}/${t("notes")}/feed.json`, url)}
    title={`${t("title")} (JSON Feed)`}
/>
