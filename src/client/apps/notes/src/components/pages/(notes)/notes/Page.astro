---
import Layout from "~/components/(layout)/Donuts.astro";

import Notes from "./_components/(notes)/Notes.astro";
import { getLocale } from "~/modules/i18n/locale";
import { useTranslations } from "~/modules/i18n/translations";
import Head from "~/components/(common)/Head.astro";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<style lang="scss">
    $padding: 12rem;

    .container {
        position: relative;
        padding: $padding;

        width: calc(100% - 2 * $padding);
        height: calc(100% - 2 * $padding);

        display: flex;
        align-items: start;
        flex-direction: column;
        justify-content: space-between;

        z-index: 1;
    }

    @media screen and (max-width: 768px) {
        $padding-x: 4rem;
        $padding-y: 8rem;

        .container {
            padding: $padding-y $padding-x;

            width: calc(100% - 2 * $padding-x);
            height: calc(100% - 2 * $padding-y);

            text-align: center;
            align-items: center;
        }
    }
</style>

<Layout
    console={[[`alex@lumine:~/${locale}/${t("notes")}/ > `, 25]]}
    locale={locale}
    title={t("title")}
>
    <div class="container">
        <Notes />
    </div>
    <Head slot="head"/>
</Layout>
