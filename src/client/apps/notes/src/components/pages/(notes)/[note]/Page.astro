---
import Layout from "~/components/(layout)/Read.astro";
import Button from "~/components/custom/Button.astro";
import Tools from "./_components/Tools.astro";
import { getCollection, render } from "astro:content";
import type { Locale } from "~/modules/i18n/locale";
import type { DataEntryMap } from "astro:content";
import Drop from "./_components/Drop.astro";
import { useTranslations } from "~/modules/i18n/translations/index.ts";
import { getLocale } from "~/modules/i18n/locale.ts";
import Head from "~/components/(common)/Head.astro";

type Entry = DataEntryMap["notes"][string];

export function getGetStaticPaths(locale: Locale) {
    return async function getStaticPaths() {
        const entries = await getCollection(
            "notes",
            ({ id }) => id.split("/")[0] === locale,
        );

        return entries.map((entry) => {
            return {
                params: {
                    slug: entry.id.split("/")[1].split("-").slice(1).join("-"),
                },
                props: {
                    entry,
                    locale,
                },
            };
        });
    };
}

export type Props = { entry: Entry; locale: Locale };

const { entry, locale } = Astro.props;

const { slug } = Astro.params;

const { Content, headings } = await render(entry);

// Translations
// ------------
const t = useTranslations(getLocale(Astro.url));
---

<style lang="scss">
    .container {
        padding: 8rem;
        display: flex;
        flex-direction: row;
    }

    .sidebar {
        width: 15rem;
    }

    .content {
        max-width: 40rem;
        padding: 1rem;
        overflow: scroll;

        header {
            margin-bottom: 1rem;
        }
    }
</style>

<style lang="scss">
    .table-of-contents {
        position: fixed;
        top: 8rem;
        margin-left: 2rem;
        max-width: 8rem;
        overflow: none;

        ul {
            all: unset;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            li {
                all: unset;
                a {
                    color: #fff;
                    text-decoration: none;
                }
            }
        }
    }
</style>

<style>
    .tts {
        position: relative;
        right: -2rem;
        top: 0;
    }
</style>

<Layout
    console={[
        [`alex@lumine:~/${locale}/${t("notes")} >`, 15],
        [`cat ${slug.slice(0, 12 + t("notes").length)}...`, 25],
        [`...${slug.slice(-(13 + t("notes").length))}.md`, 50],
    ]}
    locale={locale}
    title={entry.data.title}
>
    <Drop />
    <div class="container">
        <div class="sidebar">
            <div class="table-of-contents">
                <ul>
                    {
                        headings.map((heading, idx) => (
                            <li>
                                <a href={`#${heading.slug}`}>
                                    {idx + 1 + ". " + heading.text}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <Tools />
        </div>
        <div class="content">
            <header>
                <h1 class="title">
                    {entry.data.title}
                </h1>
                <div>
                    <p class="labels">
                        {entry.data.labels.map((label) => <span>{label}</span>)}
                    </p>
                    <p class="datetime">
                        <span>31.01.2024</span>
                        <span>23:45</span>
                    </p>
                </div>
            </header>
            <main>
                <Content />
            </main>
            <div>
                Find more notes <a href={`/${locale}`}>here</a>.
            </div>
        </div>
        <Button class="tts">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
            >
                <path
                    d="M12 4V20M8 9V15M20 10V14M4 10V14M16 7V17"
                    stroke="white"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </Button>
    </div>
    <Head slot="head"/>
</Layout>
