---
import Layout from "~/components/(layout)/Donuts.astro";

interface Props {
	locale: string;
	title: string;
}

const { locale, title } = Astro.props;
---

<style lang="scss">
    $padding: 12rem;

    .container {
        position: relative;
        padding: $padding;

        width: calc(100% - 2 * $padding);
        height: calc(100% - 2 * $padding);

        display: flex;
        align-items: start;
        flex-direction: column;
        justify-content: space-between;

        z-index: 1;
    }

    @media screen and (max-width: 768px) {
        $padding-x: 4rem;
        $padding-y: 8rem;

        .container {
            padding: $padding-y $padding-x;

            width: calc(100% - 2 * $padding-x);
            height: calc(100% - 2 * $padding-y);

            text-align: center;
            align-items: center;
        }
    }
</style>

<Layout
	console={[["alex@albedo:/dev/null >", 25]]}
	locale={locale}
	title={title}
>
	<div class="container">
		<h1 style="font-weight: bold;font-size: 8rem;">
			This page could not be found.
		</h1>
	</div>
</Layout>
