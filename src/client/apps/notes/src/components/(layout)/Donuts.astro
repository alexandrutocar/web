---
import Console from "~/components/(console)/Console.astro";
import Layout from "~/components/(layout)/Common.astro";
import Line from "~/components/(console)/Line.astro";

import Donuts from "~/components/(donuts)/Donuts.astro";

interface Props {
    console: [string, number][];
    locale: string;
    title: string;
}

const { console, locale, title } = Astro.props;
---

<Layout title={title} locale={locale}>
    <slot name="head" slot="head" />
    <header>
        <Console data-console={JSON.stringify(console)}>
            {console.map(([text]) => <Line>{text}</Line>)}
        </Console>
    </header>
    <main
        class="container"
        style="width: 100%; height: 100%; overflow: hidden; position: relative;"
    >
        <slot />
        <Donuts />
    </main>
</Layout>

<script>
    import { animate } from "~/components/(console)/Console.animate.ts";

    console.log(document.querySelectorAll<HTMLElement>("[data-console]"));

    for (const element of document.querySelectorAll<HTMLElement>(
        "[data-console]",
    )) {
        const lines: [string, number][] = JSON.parse(
            element.dataset.console ?? "[]",
        );

        lines.forEach(([text, drag], index) => {
            animate(index, text, drag);
        });
    }
</script>
