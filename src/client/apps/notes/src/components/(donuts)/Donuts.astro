---
import Donut from "./_components/Donut.astro";
---

<style lang="scss">
    .container {
        position: fixed;
        inset: 0;
        z-index: -1;

        overflow: hidden;
        pointer-events: none;

        background-color: rgba(0, 0, 0, 0.05);
    }
</style>

<div class="container">
	<Donut
		x="10%"
		y="90%"
		rotate="-116.22deg"
		scale={2.5}
		blur="10px"
		sm={{ x: "8%", y: "88%", scale: 1.6, blur: "0", opacity: 0.1 }}
	/>
	<Donut
		x="46%"
		y="4%"
		rotate="180deg"
		scale={2.5}
		blur="10px"
		sm={{ x: "58%", y: "6%", scale: 1.6, blur: "0", opacity: 0.1 }}
	/>
	<Donut
		x="93%"
		y="72%"
		rotate="130.94deg"
		scale={2.5}
		blur="10px"
		sm={{ x: "90%", y: "48%", scale: 1.6, blur: "0", opacity: 0.1 }}
	/>
</div>
